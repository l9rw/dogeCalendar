{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dogeCalendar",
  "version": "0.1.3",
  "identifier": "com.example.calendar",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "dogeCalendar",
        "width": 420,
        "height": 510,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "acceptFirstMouse": true,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5MjYxQjI2ODVBQUI2NzUKUldSMXRxcUZKaHNtV2RmbVhWb2FtdGQ4cDFtd0RnWThHNnhzV20wR3h4UC8wd21qQldGazdhYjcK",
      "endpoints": ["https://github.com/l9rw/dogeCalendar/releases/latest/download/latest.json"]
    }
  }
}
